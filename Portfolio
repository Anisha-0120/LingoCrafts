    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    header img {
      width: 100px;
      height: auto;
      margin-bottom: 1rem;
    }

    header h1 {
      margin: 0;
      font-size: 2.5rem;
    }

    section {
      padding: 2rem;
      max-width: 900px;
      margin: auto;
      animation: fadeIn 1.2s ease-in;
    }

    h2 {
      color: #f7c948;
      margin-top: 2rem;
    }

    ul {
      line-height: 1.8;
      padding-left: 1.2rem;
    }

    footer {
      text-align: center;
      padding: 2rem;
      background-color: #262a35;
      font-size: 0.9rem;
      animation: fadeIn 1.4s ease-in;
    }

    .highlight {
      color: #f7c948;
      font-weight: bold;
    }

    a {
      color: #f7c948;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
